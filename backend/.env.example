PORT=5000
NODE_ENV=development

# Option 1: Full Connection String (recommended for Neon / Render / Supabase)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Option 2: Discrete parameters
DB_HOST=localhost
DB_PORT=5432
DB_NAME=personal_finance_db
DB_USER=finance_app
DB_PASSWORD=your_db_password_here
DB_SSL=false

JWT_SECRET=your_jwt_secret_key_must_be_at_least_16_characters_long
JWT_EXPIRES_IN=15m

CORS_ORIGIN=http://localhost:5173